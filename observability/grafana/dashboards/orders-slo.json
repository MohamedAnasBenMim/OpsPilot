{
  "uid": "opspilot-slo",
  "title": "OpsPilot — orders-api SLO",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "tags": [
    "opspilot",
    "slo"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilité (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:error_ratio:rate1h{job=\"orders-api\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Budget d'erreur restant (burn 1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (slo:error_ratio:rate1h{job=\"orders-api\"} / 0.005)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latence p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:latency_p95_seconds:5m{job=\"orders-api\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Incidents diagnostiqués",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(opspilot_diagnoses_total[24h]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Trafic (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"orders-api\"}[1m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Taux d'erreur 5xx vs SLO",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.005
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:error_ratio:rate5m{job=\"orders-api\"}",
          "legendFormat": "erreurs"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latence p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:latency_p95_seconds:5m{job=\"orders-api\"}",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Appels amont (paiement)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(upstream_requests_total{job=\"orders-api\"}[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pool de connexions DB",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(db_pool_in_use{job=\"orders-api\"})",
          "legendFormat": "utilisées"
        },
        {
          "refId": "B",
          "expr": "max(db_pool_max{job=\"orders-api\"})",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Mémoire (Mo)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(process_resident_memory_bytes{job=\"orders-api\"}) / 1048576",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU (cœurs)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(process_cpu_seconds_total{job=\"orders-api\"}[1m]))",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Diagnostics OpsPilot par cause",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (root_cause) (increase(opspilot_diagnoses_total[1h]))",
          "legendFormat": "{{root_cause}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}